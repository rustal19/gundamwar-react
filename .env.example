REACT_APP_API_SEARCH_URL=https://gundamwar.net/api/search
# Local development only. Production can use same-origin /api without this.
REACT_APP_API_BASE_URL=http://localhost:3001
# Optional frontend override. If omitted, the app reads Google Client ID from /api/auth/config.
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_ENABLE_LOCAL_AUTH_MOCK=true
REACT_APP_CARD_IMAGE_BASE_URL=/card-images
REACT_APP_CARD_THUMB_IMAGE_BASE_URL=/card-images-thumb
# Optional. GA4 Measurement ID (example: G-XXXXXXXXXX)
REACT_APP_GA_MEASUREMENT_ID=
